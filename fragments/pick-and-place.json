{
  "modules": [
    {
      "type": "registry",
      "name": "dtcurrie_isaac-sim",
      "module_id": "dtcurrie:isaac-sim",
      "version": "latest-with-prerelease"
    }
  ],
  "components": [
    {
      "name": "sim-world",
      "namespace": "rdk",
      "type": "generic",
      "model": "dtcurrie:isaac-sim:world",
      "attributes": {
        "headless": true,
        "livestream": true,
        "props": [
          {
            "name": "pick_cube",
            "type": "cube",
            "position": [0.7, 0.25, 0.03],
            "size": 0.06,
            "color": [0.9, 0.1, 0.1]
          },
          {
            "name": "place_pad",
            "type": "cube",
            "fixed": true,
            "position": [0.7, -0.35, 0.005],
            "size": 0.2,
            "scale": [1, 1, 0.05],
            "color": [0.1, 0.3, 0.9]
          }
        ],
        "lighting": {
          "dome": {
            "intensity": 1000,
            "color": [1, 1, 1]
          },
          "sphere_intensity": 30000
        }
      }
    },
    {
      "name": "pick-arm",
      "namespace": "rdk",
      "type": "arm",
      "model": "dtcurrie:isaac-sim:arm",
      "frame": {
        "parent": "world"
      },
      "attributes": {
        "world": "sim-world",
        "asset": "ur5e"
      }
    },
    {
      "name": "scene-cam",
      "namespace": "rdk",
      "type": "camera",
      "model": "dtcurrie:isaac-sim:camera",
      "frame": {
        "parent": "world",
        "translation": { "x": 2200, "y": 2200, "z": 2000 }
      },
      "attributes": {
        "world": "sim-world",
        "target": [0.6, 0, 0.2],
        "width": 1280,
        "height": 720
      }
    },
    {
      "name": "wrist-cam",
      "namespace": "rdk",
      "type": "camera",
      "model": "dtcurrie:isaac-sim:camera",
      "frame": {
        "parent": "pick-arm",
        "translation": { "x": 0, "y": 0, "z": 60 },
        "orientation": {
          "type": "ov_degrees",
          "value": { "x": 0, "y": 0, "z": 1, "th": 180 }
        }
      },
      "attributes": {
        "world": "sim-world",
        "parent_prim": "/World/pick_arm/wrist_3_link",
        "depth": true,
        "width": 848,
        "height": 480,
        "fov_deg": 90.5
      }
    }
  ],
  "services": [
    {
      "name": "builtin",
      "api": "rdk:service:motion",
      "model": "rdk:builtin:builtin",
      "attributes": {}
    },
    {
      "name": "red-detector",
      "api": "rdk:service:vision",
      "model": "color_detector",
      "attributes": {
        "detect_color": "#EA8D8D",
        "hue_tolerance_pct": 0.1,
        "segment_size_px": 100,
        "value_cutoff_pct": 0.15,
        "camera_name": "wrist-cam"
      }
    },
    {
      "name": "block-segmenter",
      "api": "rdk:service:vision",
      "model": "viam:vision:detections-to-segments",
      "attributes": {
        "detector_name": "red-detector",
        "camera_name": "wrist-cam",
        "mean_k": 5,
        "sigma": 1.25,
        "confidence_threshold_pct": 0.5,
        "infer_minimum_depth": true
      }
    }
  ]
}
